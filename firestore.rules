rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return verified() && request.auth.token.email.lower() == 'flapser66@gmail.com';
    }
    function isMember() {
      return isAdmin() || (verified() &&
        exists(/databases/$(database)/documents/leden/$(request.auth.token.email.lower())));
    }
    match /leden/{email} {
      allow read: if isAdmin() || (verified() && email == request.auth.token.email.lower());
      allow write: if isAdmin();
    }
    match /lakdagen/{id} {
      allow read, write: if isMember();
    }
    match /instellingen/{id} {
      allow read, write: if isMember();
    }
  }
}
